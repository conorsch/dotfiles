#!/usr/bin/env bash
# Reset movie-mode whenever logind announces the system is about to sleep.
#
# logind broadcasts org.freedesktop.login1.Manager.PrepareForSleep on the
# system bus: (true) just before suspend, (false) after resume. We act on
# the pre-sleep (true) signal so the reset runs while the session is still
# fully alive, avoiding races with X/displays coming back up on resume.
set -euo pipefail

gdbus monitor --system \
  --dest org.freedesktop.login1 \
  --object-path /org/freedesktop/login1 |
while read -r line; do
  case "$line" in
    *"PrepareForSleep (true"*) "$HOME/bin/movie-mode" off || true ;;
  esac
done
