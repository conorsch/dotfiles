#!/usr/bin/env bash
# Script to configure display for watching a movie.
set -euo pipefail

requested_mode="${1:-on}"


function enable_movie_mode() {
  # disable automatic screen sleep.
  xset s off -dpms

  # stop screenlock service
  # TODO: is this necessary? disabling dpms should be sufficient, no?
  systemctl --user stop xss-lock

  # disable warm mode via redshift for the duration of the movie
  systemctl --user stop redshift

  # Safety net: fully reset movie-mode after 5h of awake time. The
  # PrepareForSleep listener (movie-mode-suspend-watch.service) handles the
  # normal close-the-laptop case; this covers a machine left awake where we
  # never suspend or run "off" by hand. DISPLAY is set explicitly because a
  # transient --user unit doesn't reliably inherit it (cf. redshift.service).
  systemd-run --user --on-active=5h --remain-after-exit true --setenv=DISPLAY=:0 "$HOME/bin/movie-mode" off

  # configure external displays
  monitor-setup -m movie
}

function disable_movie_mode() {
  # disable automatic screen sleep.
  xset s on -dpms

  # restart screenlock service
  systemctl --user start xss-lock

  # re-enable warm mode via redshift (unmask first in case the 5h timer hasn't fired yet)
  systemctl --user unmask redshift
  systemctl --user restart redshift

  # configure external displays
  monitor-setup
}

if [[ "$requested_mode" = "on" ]] ; then
  enable_movie_mode
elif [[ "$requested_mode" = "off" ]] ; then
  disable_movie_mode
fi

