#!/usr/bin/env bash
# Install LLM-related CLI tooling
set -euo pipefail


gum log --level info "Installing claude code..."

# Legacy: remove pnpm-installed claude-code
# Ensure we have pnpm, presumably via nix.
# We use pnpm rather than npm because it works well for installing globally.
if ! hash pnpm > /dev/null 2>&1 ; then
  >&2 echo "WARN: pnpm is not installed; maybe dotfiles not set up?"
else
  if [[ -n "$(pnpm list -g @anthropic-ai/claude-code)" ]] ; then
    gum log --level debug "Uninstalling pnpm-managed claude-code..."
    pnpm remove -g @anthropic-ai/claude-code
  fi
fi
if ! hash claude > /dev/null 2>&1 ; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

gum log --level debug "Installing codex..."
pnpm install q -g @openai/codex

gum log --level info "Installing crush..."
pnpm install -q -g @charmland/crush

gum log --level info "Installing opencode..."
# opencode automatically self-updates on start,
# so we don't need to rerun the command.
if ! hash opencode > /dev/null 2>&1 ; then
  curl -fsSL https://opencode.ai/install | bash
fi
