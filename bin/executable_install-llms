#!/usr/bin/env bash
# Install LLM-related CLI tooling
set -euo pipefail

if ! is-workstation ; then
    >&2 echo "Skipping LLM tooling installation: not a workstation"
    exit 0
fi



# Ensure we have pnpm, presumably via nix.
# We use pnpm rather than npm because it works well for installing globally.
if ! hash pnpm > /dev/null 2>&1 ; then
  >&2 echo "ERROR: pnpm is not installed; maybe dotfiles not set up?"
  exit 1
fi

gum log --level info "Installing claude code..."
if ! hash claude > /dev/null 2>&1 ; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

gum log --level debug "Installing codex..."
pnpm install -q -g @openai/codex

gum log --level info "Installing crush..."
pnpm install -q -g @charmland/crush

gum log --level info "Installing opencode..."
# opencode automatically self-updates on start,
# so we don't need to rerun the command.
if ! hash opencode > /dev/null 2>&1 ; then
  curl -fsSL https://opencode.ai/install | bash
fi

gum log --level info "Installing pi..."
pnpm install -q -g --ignore-scripts @earendil-works/pi-coding-agent

gum log --level info "Symlinking a single AGENTS.md across LLM clients..."
mkdir -p \
  "${HOME:?}/.pi/agents" \
  "${HOME:?}/.config/opencode" \
  "${HOME:?}/.claude"

ln -s "${HOME:?}/.local/share/ruindev/AGENTS.md" -f "${HOME:?}/.claude/CLAUDE.md"
ln -s "${HOME:?}/.local/share/ruindev/AGENTS.md" -f "${HOME:?}/.pi/agents/AGENTS.md"
ln -s "${HOME:?}/.local/share/ruindev/AGENTS.md" -f "${HOME:?}/.config/opencode/AGENTS.md"
