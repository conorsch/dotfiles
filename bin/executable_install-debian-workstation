#!/bin/bash
# Debian-specific workstation provisioning: everything that depends on
# apt or other Debian-flavored package sources lives here. Invoked by
# `install-workstation`, which handles host classification and the
# cross-distro steps.
#
# Usage: install-debian-workstation <hardware|qubes>
#
# References other scripts expected on PATH:
#
#  * install-flatpaks
#
# Note on terminals: zellij is provided cross-distro by the nix flake
# (see flake.nix `tooling`), installed via `install-workstation-packages`,
# so there is nothing to do for it here. ghostty has no official Debian
# apt package yet, so we skip it (see TODO below).
set -ueo pipefail


# Filepath that will always exist inside a QubesOS VM.
QUBES_MARKER_VM_PATH="/usr/share/qubes/marker-vm"


# Packages and repos appropriate for a bare-metal Debian workstation.
function configure_hardware_workstation() {
    # Distro-agnostic flatpak helper; it apt-installs the flatpak binary
    # first if needed, then pulls the shared app list from Flathub.
    install-flatpaks

    # TODO: ghostty has no official Debian apt package. Revisit if a stable
    # packaging path appears (e.g. an upstream .deb or a nixpkgs entry we can
    # add to flake.nix `tooling`). zellij already arrives via the nix flake.
    >&2 echo "INFO: skipping ghostty on Debian (no official apt package yet)"
}

# Provisioning inside a QubesOS AppVM. Minimal for now: no flatpaks on a
# typical AppVM, and the cross-distro nix/dev-tools steps run from the
# orchestrator.
function configure_qubes_vm() {
    if [[ ! -e "$QUBES_MARKER_VM_PATH" ]] ; then
        >&2 echo "ERROR: QubesOS marker missing: $QUBES_MARKER_VM_PATH"
        return 1
    fi

    # TODO: add Debian Qubes AppVM specifics here if/when needed.
    >&2 echo "INFO: no Debian-specific Qubes provisioning required"
}

main() {
    local ws_type="${1:-}"

    # Sanity check: refuse to run apt logic on a non-Debian host.
    if ! grep -q '^ID=debian' /etc/os-release ; then
        >&2 echo "ERROR: not a Debian system, exiting..."
        exit 1
    fi

    case "$ws_type" in
        hardware)
            configure_hardware_workstation
            ;;
        qubes)
            configure_qubes_vm
            ;;
        *)
            >&2 echo "Usage: $0 <hardware|qubes>"
            exit 1
            ;;
    esac
}

main "$@"
exit 0
