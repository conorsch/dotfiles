#!/bin/bash
# Install developer tooling, but only those tools appropriate
# for an interactive graphical workstation. There are a few categories
# of workstation, which must be handled slightly differently,
# in terms of config:
#
#   * physical laptop
#   * graphical workstations, via ssh
#   * qubes vms
#   * hardware servers (should be ignored)
#
#  This script is the OS-agnostic orchestrator. It classifies the host
#  (workstation type + laptop flag), detects the OS, then dispatches the
#  package-manager-specific work to a per-distro helper. Distro-specific
#  logic (dnf/copr/apt) lives in those helpers, not here.
#
#  This script references other scripts that are expected to be on PATH:
#
#  * install-fedora-workstation   (dnf/copr/rpm-fusion logic)
#  * install-debian-workstation   (apt/flatpak logic)
#  * install-nix
#  * install-workstation-packages (base apt/dnf packages + nix flake tooling)
#  * install-dev-tools
set -ueo pipefail


# Detect the OS family from /etc/os-release. Echoes "fedora" or "debian",
# matching the suffix of the per-distro helper scripts. Exits on anything
# else, since we have no provisioning path for it.
function detect_os_id() {
    local os_id
    os_id="$(grep -oP '^ID=\K\w+' /etc/os-release 2>/dev/null || echo '')"
    case "$os_id" in
        fedora|debian)
            echo "$os_id"
            ;;
        *)
            >&2 echo "ERROR: unsupported OS (ID='$os_id'); expected fedora or debian"
            exit 1
            ;;
    esac
}

# Enable the user-level GUI services on a hardware workstation. These are
# all `systemctl --user` units, so they're distro-independent.
function configure_workstation_services() {
    # TODO port these source services from chezmoi?
    systemctl --user daemon-reload
    systemctl --user enable --now redshift
    systemctl --user enable --now syncthing
    systemctl --user enable --now movie-mode-suspend-watch
}

# Run laptop-specific configs, for battery monitoring.
function configure_laptop_services() {
    # Files have already been copied, so we can assume the battery-monitor
    # scripts and user-level systemd services are in place.
    systemctl --user daemon-reload
    systemctl --user enable --now battery-monitor battery-monitor.timer
}

# Primary script entrypoint. Classify the host, then dispatch the
# distro-specific package work and run the shared steps.
main() {
    # Ensure primary env is sourced, in case this is a fresh host.
    # shellcheck source=/dev/null
    source "${HOME:?}/.bashrc"

    local os_id chassis ws_type
    os_id="$(detect_os_id)"
    chassis="$(hostnamectl status --json pretty | jq -r .Chassis)"
    # Delegate workstation classification to the shared is-workstation tool,
    # which is the single source of truth for these rules. Empty when this
    # host is not a workstation we provision.
    ws_type="$(is-workstation --type || true)"

    # Provision the workstation, if this host is one we recognize.
    if [[ -n "$ws_type" ]] ; then
        # Distro-specific repos and native packages.
        "install-${os_id}-workstation" "$ws_type"

        # Cross-distro steps, common to every workstation type.
        install-nix

        # Base apt/dnf packages (packages/*.txt) plus the cross-distro nix
        # flake tooling. Must run after install-nix, since its internal
        # `nix profile install` step needs nix on PATH; the base-package
        # phase has no such dependency.
        install-workstation-packages

        install-dev-tools

        # GUI user services only make sense on a full hardware workstation,
        # not inside a headless Qubes AppVM.
        if [[ "$ws_type" = "hardware" ]] ; then
            configure_workstation_services
        fi
    fi

    # Laptop battery services are independent of workstation type and OS.
    if [[ "$chassis" = "laptop" ]] ; then
        configure_laptop_services
    fi
}

main
exit 0
