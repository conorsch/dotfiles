{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder-next:latest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llm.ruin.dev/v1",
        "apiKey": "{env:OLLAMA_API_KEY}",
        "timeout": 60000000
      },
      "models": {
        "qwen3-coder-next:latest": {
          "tools": true,
          "limit": {
            "context": 256000,
            "output": 32000
          }
        },
        "qwen3-coder:30b": {
          "tools": true,
          "limit": {
            "context": 100000,
            "output": 32000
          }
        },
        "qwen3.5:9b": {
          "tools": true,
          "limit": {
            "context": 100000,
            "output": 32000
          }
        }
      }
    }
  }
}
